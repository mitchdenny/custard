<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Hex1b/Hex1b.csproj" />
    <None Remove="Tapes/**/*.tape" />
    <Content Include="Tapes/**/*.tape" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildWebTerminalFrontend" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../../src/web-terminal/node_modules/typescript/bin/tsc')"
           Text="Restore the web terminal package first: npm ci --prefix src/web-terminal (from the repository root)." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/node_modules/typescript/bin/tsc')"
           Text="Restore the demo frontend first: npm ci --prefix samples/WebTerminalDemo (from the repository root)." />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm run build" />
    <ItemGroup>
      <Content Remove="wwwroot/web-terminal/**/*;wwwroot/playground/**/*" />
      <Content Include="wwwroot/web-terminal/**/*;wwwroot/playground/**/*"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
